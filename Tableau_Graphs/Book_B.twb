      <column caption='Consumption % Change (2020 - 2025)' datatype='real' name='[Calculation_0406058392838147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM(IF [period] = 2025 THEN [consumption] END)&#13;&#10;    -&#13;&#10;    SUM(IF [period] = 2020 THEN [consumption] END)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(IF [period] = 2020 THEN [consumption] END)' />
